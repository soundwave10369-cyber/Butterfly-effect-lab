<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070b14">
<title>CHAOS LAB // Butterfly Effect Explorer</title>
<style>
:root{--bg:#070b14;--panel:rgba(13,21,36,.9);--panel2:#111d30;--line:rgba(151,181,222,.17);--ink:#edf4ff;--muted:#8fa2bd;--gold:#ffc66e;--cyan:#75d9ed;--green:#8ce0b3;--red:#ff9297;--r:17px}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,select{font:inherit}button{cursor:pointer;color:inherit}
#scene{position:fixed;inset:0;width:100%;height:100%;touch-action:none}
.shade{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 45%,transparent 35%,rgba(2,5,12,.42) 100%)}
.top{position:fixed;top:0;left:0;right:0;padding:calc(14px + env(safe-area-inset-top)) 18px 12px;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
.brand{display:flex;align-items:center;gap:11px;pointer-events:auto}.mark{width:38px;height:38px;border-radius:12px;border:1px solid #75d9ed55;background:#75d9ed12;display:grid;place-items:center;color:var(--cyan);font-size:21px}
.brand b{display:block;font-size:12px;letter-spacing:.2em}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:.16em;margin-top:2px}
.statuses{display:flex;gap:7px;pointer-events:auto}.chip{background:var(--panel);border:1px solid var(--line);border-radius:99px;padding:7px 11px;font-size:10px;color:var(--muted);letter-spacing:.08em;backdrop-filter:blur(15px)}.chip strong{color:var(--green)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);backdrop-filter:blur(17px);box-shadow:0 18px 55px #0006}
.left{position:fixed;top:82px;left:16px;bottom:16px;width:238px;padding:15px;display:flex;flex-direction:column;gap:13px;overflow:auto}
.right{position:fixed;top:82px;right:16px;width:248px;padding:15px;display:flex;flex-direction:column;gap:12px}
.eyebrow{display:flex;align-items:center;justify-content:space-between;font-size:9px;color:var(--muted);font-weight:800;letter-spacing:.17em;text-transform:uppercase}
.sep{border-top:1px solid var(--line);padding-top:12px}
.group{display:flex;flex-direction:column;gap:10px}.range{display:grid;grid-template-columns:1fr auto;gap:4px 9px}.range label{font-size:11px;color:var(--muted)}.range output{font-size:11px;color:var(--gold);font-variant-numeric:tabular-nums}.range input{grid-column:1/-1;width:100%;accent-color:var(--gold)}
.row{display:flex;gap:7px;align-items:center}.row>*{flex:1}
.btn{border:1px solid var(--line);background:#ffffff09;border-radius:10px;padding:9px 10px;font-size:10px;font-weight:750;letter-spacing:.04em;transition:.18s}.btn:hover{background:#ffffff16;border-color:#ffffff45}.btn.primary{background:var(--gold);color:#201709;border-color:var(--gold)}.btn.active{color:var(--cyan);border-color:#75d9ed66;background:#75d9ed12}
.preset{display:grid;grid-template-columns:1fr 1fr;gap:6px}.preset button{text-align:left;font-size:10px}
.switchrow{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:11px;margin:8px 0}.switch{width:34px;height:19px;border:0;border-radius:20px;background:#29364c;padding:2px}.switch:after{content:"";display:block;width:15px;height:15px;background:#bac7d9;border-radius:50%;transition:.2s}.switch.on{background:#75d9ed66}.switch.on:after{transform:translateX(15px);background:var(--cyan)}
.metricgrid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.metric{padding:9px;background:#ffffff08;border:1px solid #ffffff0d;border-radius:11px;min-width:0}.metric small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.1em}.metric b{display:block;font-size:13px;margin-top:4px;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chartbox{background:#ffffff06;border:1px solid #ffffff0d;border-radius:12px;padding:8px}.charttitle{display:flex;justify-content:space-between;font-size:9px;color:var(--muted);letter-spacing:.08em;margin-bottom:5px}.charttitle b{color:var(--cyan)}#graph{width:100%;height:95px;display:block}
.note{font-size:10px;color:var(--muted);line-height:1.55}.note strong{color:#dbe8fa}
.bottom{position:fixed;left:50%;bottom:calc(15px + env(safe-area-inset-bottom));transform:translateX(-50%);width:min(610px,calc(100vw - 32px));padding:11px 13px}
.transport{display:flex;gap:7px;align-items:center}.spacer{flex:1}.timebar{display:flex;align-items:center;gap:9px;margin-top:9px}.timebar label{font-size:9px;color:var(--muted);white-space:nowrap;letter-spacing:.1em}.timebar input{flex:1;min-width:25px;accent-color:var(--gold)}.timebar output{font-size:10px;color:var(--gold);min-width:54px;text-align:right}
.hint{position:fixed;top:75px;left:50%;transform:translateX(-50%);font-size:9px;color:#b3c1d4aa;letter-spacing:.12em;white-space:nowrap;pointer-events:none}
.legend{display:flex;gap:10px;flex-wrap:wrap;font-size:9px;color:var(--muted)}.legend span{display:flex;align-items:center;gap:5px}.swatch{width:7px;height:7px;border-radius:50%;display:inline-block}
.toast{position:fixed;top:70px;left:50%;transform:translate(-50%,-8px);opacity:0;background:var(--panel2);border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:10px;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){.left{width:210px;left:10px}.right{right:10px;width:218px}}
@media(max-width:650px){
 .top{padding-left:11px;padding-right:11px}.mark{width:32px;height:32px}.brand b{font-size:10px}.brand small{font-size:8px}.chip{font-size:8px;padding:6px 8px}
 .left{top:61px;left:9px;bottom:auto;width:calc(100vw - 18px);max-height:108px;padding:9px 11px;gap:7px;overflow:hidden}
 .left>.eyebrow,.left>.sep,.left .group{display:none}.preset{display:flex;overflow:auto}.preset button{flex:none;white-space:nowrap;padding:7px 9px}
 .right{top:auto;right:9px;bottom:115px;width:190px;padding:10px;gap:8px}.right .note{display:none}.right .eyebrow{font-size:8px}.metric{padding:7px}.metric small{font-size:8px}.metric b{font-size:11px}#graph{height:70px}
 .bottom{bottom:calc(9px + env(safe-area-inset-bottom));width:calc(100vw - 18px);padding:8px}.btn{font-size:9px;padding:8px 8px}.transport{gap:5px}.timebar{margin-top:7px}.hint{top:176px;font-size:8px}
}
@media(max-width:390px){.right{width:166px}.transport .btn{padding:7px 6px}}
</style>
</head>
<body>
<canvas id="scene"></canvas><div class="shade"></div>
<header class="top">
 <div class="brand"><div class="mark">⟲</div><div><b>CHAOS LAB <span style="color:var(--cyan)">/</span> BUTTERFLY EFFECT</b><small>DETERMINISTIC SYSTEMS · SENSITIVITY EXPERIMENT</small></div></div>
 <div class="statuses"><div class="chip">STATUS <strong id="status">● RUNNING</strong></div><div class="chip" id="count">160 TRAJECTORIES</div></div>
</header>
<aside class="panel left">
 <div class="eyebrow"><span>Experiment design</span><span>01 / 03</span></div>
 <div class="group">
  <div class="range"><label for="spread">Initial angular difference</label><output id="spreadOut">1.0e-5 rad</output><input id="spread" type="range" min="0" max="100" value="50"></div>
  <div class="range"><label for="speed">Simulation speed</label><output id="speedOut">1.0×</output><input id="speed" type="range" min="10" max="300" value="100"></div>
 </div>
 <div class="sep">
  <div class="eyebrow">Starting conditions</div>
  <div class="preset" style="margin-top:9px">
   <button class="btn" data-preset="calm">01 · Calm start</button>
   <button class="btn" data-preset="chaotic">02 · Chaotic start</button>
   <button class="btn" data-preset="tiny">03 · Tiny difference</button>
   <button class="btn" data-preset="wide">04 · Wide spread</button>
  </div>
 </div>
 <div class="sep">
  <div class="eyebrow">Visual layers</div>
  <div class="switchrow"><span>Pendulum arms</span><button class="switch on" id="armsToggle"></button></div>
  <div class="switchrow"><span>Trajectory trails</span><button class="switch on" id="trailsToggle"></button></div>
  <div class="switchrow"><span>Highlight comparison pair</span><button class="switch on" id="pairToggle"></button></div>
 </div>
 <div class="sep note"><strong>Model:</strong> 160 ideal double pendulums with equal unit masses and lengths. Each evolves independently under gravity using a fourth-order Runge–Kutta integrator.</div>
</aside>
<aside class="panel right">
 <div class="eyebrow"><span>Live measurements</span><span style="color:var(--green)">LIVE</span></div>
 <div class="metricgrid">
  <div class="metric"><small>Elapsed time</small><b id="timeVal">0.00 s</b></div>
  <div class="metric"><small>Tip separation</small><b id="gapVal">0.00 px</b></div>
  <div class="metric"><small>Energy · A</small><b id="energyA">—</b></div>
  <div class="metric"><small>Energy · B</small><b id="energyB">—</b></div>
 </div>
 <div class="chartbox">
  <div class="charttitle"><span>LOG DIVERGENCE</span><b>log₁₀(Δθ)</b></div>
  <canvas id="graph"></canvas>
 </div>
 <div class="legend"><span><i class="swatch" style="background:#75d9ed"></i> Pendulum A</span><span><i class="swatch" style="background:#ffc66e"></i> Pendulum B</span></div>
 <div class="note">The graph tracks the angular separation of two simulations that begin almost identically. A growing gap is the signature of sensitivity to initial conditions.</div>
</aside>
<div class="hint">DRAG THE LOWER BOB TO SET THE STARTING POSE · RELEASE TO RUN</div>
<section class="panel bottom">
 <div class="transport">
  <button class="btn primary" id="play">Ⅱ &nbsp; PAUSE</button>
  <button class="btn" id="step">STEP</button>
  <button class="btn" id="replay">↺ RESET</button>
  <button class="btn" id="random">RANDOM</button>
  <span class="spacer"></span>
  <button class="btn active" id="clear">CLEAR TRAILS</button>
 </div>
 <div class="timebar"><label>TIME FLOW</label><input id="speed2" type="range" min="10" max="300" value="100"><output id="speedOut2">1.0×</output></div>
</section>
<div class="toast" id="toast"></div>
<script>
(()=>{
'use strict';
const N=160,DT=.003,G=9.81,TAU=Math.PI*2,$=id=>document.getElementById(id);
const canvas=$('scene'),ctx=canvas.getContext('2d'),graph=$('graph'),gx=graph.getContext('2d');
const a1=new Float64Array(N),a2=new Float64Array(N),v1=new Float64Array(N),v2=new Float64Array(N);
const px=new Float64Array(N),py=new Float64Array(N),colors=Array.from({length:N},(_,i)=>i===0?'#75d9ed':i===N-1?'#ffc66e':`hsl(${195+(i-1)/(N-3)*105},88%,${58+i%3*4}%)`);
let W=0,H=0,dpr=1,ox=0,oy=0,L=100,spread=1e-5,elapsed=0,acc=0,last=performance.now(),running=true;
let arms=true,trails=true,pairOn=true,drag=false,dragPointer=null,pose1=2.15,pose2=2.35,history=[],frame=0,toastTimer;
const pairA=0,pairB=N-1;
const eps=()=>Math.pow(10,-10+(+$('spread').value/100)*8);
const speed=()=>+$('speed').value/100;
function resize(){
 dpr=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
 canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
 const r=graph.getBoundingClientRect();graph.width=Math.max(1,Math.floor(r.width*dpr));graph.height=Math.max(1,Math.floor(r.height*dpr));gx.setTransform(dpr,0,0,dpr,0,0);
 ox=W/2;oy=H*.36;L=Math.max(38,Math.min(W*.17,H*.19,125));
 clearTrails();
}
function acceleration(a,b,p,q){
 const d=a-b,s=Math.sin(d),c=Math.cos(d),den=3-Math.cos(2*d);
 const aa=(-3*G*Math.sin(a)-G*Math.sin(a-2*b)-2*s*(q*q+p*p*c))/den;
 const bb=(2*s*(2*p*p+2*G*Math.cos(a)+q*q*c))/den;
 return [aa,bb];
}
function derivative(y){
 const [a,b,p,q]=y,[aa,bb]=acceleration(a,b,p,q);
 return [p,q,aa,bb];
}
function rk4(i,h){
 const y=[a1[i],a2[i],v1[i],v2[i]],k1=derivative(y);
 const add=(base,k,f)=>base.map((v,j)=>v+f*k[j]);
 const k2=derivative(add(y,k1,h/2)),k3=derivative(add(y,k2,h/2)),k4=derivative(add(y,k3,h));
 const out=y.map((v,j)=>v+h/6*(k1[j]+2*k2[j]+2*k3[j]+k4[j]));
 a1[i]=out[0];a2[i]=out[1];v1[i]=out[2];v2[i]=out[3];
}
function energy(i){
 const c=Math.cos(a1[i]-a2[i]);
 const kinetic=.5*(2*v1[i]*v1[i]+v2[i]*v2[i]+2*v1[i]*v2[i]*c);
 const potential=-G*(2*Math.cos(a1[i])+Math.cos(a2[i]));
 return kinetic+potential;
}
function bob(i){
 const x1=ox+L*Math.sin(a1[i]),y1=oy+L*Math.cos(a1[i]);
 return {x:x1+L*Math.sin(a2[i]),y:y1+L*Math.cos(a2[i]),x1,y1};
}
function clearTrails(){ctx.fillStyle='#070b14';ctx.fillRect(0,0,W,H);for(let i=0;i<N;i++){px[i]=NaN;py[i]=NaN;}}
function seed(){
 const e=spread,base1=pose1,base2=pose2;
 for(let i=0;i<N;i++){a1[i]=base1+e*i/(N-1);a2[i]=base2;v1[i]=0;v2[i]=0;}
 elapsed=0;acc=0;history=[];frame=0;clearTrails();running=true;syncControls();updateHUD();drawGraph();
}
function advance(){
 for(let i=0;i<N;i++)rk4(i,DT);
 elapsed+=DT;
}
function drawBackground(){
 ctx.fillStyle='rgba(7,11,20,.13)';ctx.fillRect(0,0,W,H);
 // Subtle radial field lines
 const grad=ctx.createRadialGradient(ox,oy,5,ox,oy,Math.max(W,H)*.7);
 grad.addColorStop(0,'rgba(28,61,91,.12)');grad.addColorStop(1,'rgba(7,11,20,0)');
 ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
}
function draw(){
 drawBackground();
 // Fixed support and subtle ruler
 ctx.strokeStyle='rgba(160,190,225,.14)';ctx.lineWidth=1;
 ctx.beginPath();ctx.moveTo(ox-35,oy);ctx.lineTo(ox+35,oy);ctx.stroke();
 ctx.fillStyle='#dce9fa';ctx.beginPath();ctx.arc(ox,oy,4,0,TAU);ctx.fill();
 if(arms){
  ctx.save();ctx.globalAlpha=.17;ctx.lineWidth=1;
  for(let i=0;i<N;i++){const p=bob(i);ctx.strokeStyle=colors[i];ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(p.x1,p.y1);ctx.lineTo(p.x,p.y);ctx.stroke();}
  ctx.restore();
 }
 for(let i=0;i<N;i++){
  const p=bob(i),isA=i===pairA,isB=i===pairB;
  if(trails&&Number.isFinite(px[i])){ctx.strokeStyle=colors[i];ctx.globalAlpha=.54;ctx.lineWidth=(isA||isB)?2.1:1;ctx.beginPath();ctx.moveTo(px[i],py[i]);ctx.lineTo(p.x,p.y);ctx.stroke();}
  px[i]=p.x;py[i]=p.y;
  ctx.globalAlpha=(isA||isB)?1:.82;ctx.fillStyle=colors[i];ctx.beginPath();ctx.arc(p.x,p.y,(isA||isB)?4.2:2.15,0,TAU);ctx.fill();
  if(pairOn&&(isA||isB)){ctx.strokeStyle=isA?'#75d9ed':'#ffc66e';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(p.x,p.y,7,0,TAU);ctx.stroke();}
 }
 ctx.globalAlpha=1;
 if(drag){const p=bob(0);ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(p.x1,p.y1);ctx.lineTo(p.x,p.y);ctx.stroke();}
}
function drawGraph(){
 const w=graph.clientWidth,h=graph.clientHeight;if(!w||!h)return;
 gx.setTransform(dpr,0,0,dpr,0,0);gx.clearRect(0,0,w,h);
 const lo=-12,hi=2,span=20,t0=Math.max(0,elapsed-span);
 gx.strokeStyle='rgba(145,170,205,.17)';gx.lineWidth=1;
 for(let k=-12;k<=0;k+=3){const y=h-(k-lo)/(hi-lo)*h;gx.beginPath();gx.moveTo(0,y);gx.lineTo(w,y);gx.stroke();}
 gx.strokeStyle='#75d9ed';gx.lineWidth=1.8;gx.beginPath();let started=false;
 for(const p of history){if(p.t<t0)continue;const x=(p.t-t0)/span*w,y=h-(Math.max(lo,Math.min(hi,p.v))-lo)/(hi-lo)*h;if(!started){gx.moveTo(x,y);started=true;}else gx.lineTo(x,y);}
 gx.stroke();gx.fillStyle='rgba(143,162,189,.8)';gx.font='9px system-ui';gx.fillText('log₁₀ angular gap',5,11);
 
}
function sample(){
 const da=Math.hypot(a1[pairA]-a1[pairB],a2[pairA]-a2[pairB]);
 history.push({t:elapsed,v:Math.log10(Math.max(da,1e-14))});if(history.length>2400)history.splice(0,400);
 drawGraph();updateHUD();
}
function updateHUD(){
 const pA=bob(pairA),pB=bob(pairB),gap=Math.hypot(pA.x-pB.x,pA.y-pB.y);
 $('timeVal').textContent=elapsed.toFixed(2)+' s';$('gapVal').textContent=gap.toFixed(3)+' px';
 $('energyA').textContent=energy(pairA).toFixed(2);$('energyB').textContent=energy(pairB).toFixed(2);
 $('status').textContent=running?'● RUNNING':'Ⅱ PAUSED';
 $('play').textContent=running?'Ⅱ  PAUSE':'▶  PLAY';$('play').classList.toggle('primary',running);
}
function syncControls(){
 $('spread').value=Math.round((Math.log10(spread)+10)/8*100);
 $('spreadOut').textContent=spread.toExponential(1)+' rad';
 $('speedOut').textContent=speed().toFixed(1)+'×';$('speedOut2').textContent=speed().toFixed(1)+'×';
 $('speed2').value=$('speed').value;
}
function setSpreadFromInput(){spread=eps();$('spreadOut').textContent=spread.toExponential(1)+' rad';seed();}
function notify(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),1700);}
function setSwitch(id,on){$(id).classList.toggle('on',on);}
function poseFromPointer(e){
 const x=(e.clientX-ox)/L,y=(e.clientY-oy)/L,d=Math.min(1.999,Math.max(.05,Math.hypot(x,y)));
 const phi=Math.atan2(x,y),alpha=Math.acos(d/2);pose1=phi+alpha;pose2=phi-alpha;
}
canvas.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);drag=true;dragPointer=e.pointerId;poseFromPointer(e);clearTrails();});
canvas.addEventListener('pointermove',e=>{if(drag&&e.pointerId===dragPointer){poseFromPointer(e);}});
function release(e){if(drag&&e.pointerId===dragPointer){drag=false;dragPointer=null;seed();notify('New initial pose set');}}
canvas.addEventListener('pointerup',release);canvas.addEventListener('pointercancel',release);
$('play').onclick=()=>{running=!running;updateHUD();};
$('step').onclick=()=>{running=false;advance();sample();draw();updateHUD();};
$('replay').onclick=()=>{seed();notify('Experiment restarted');};
$('random').onclick=()=>{pose1=(Math.random()<.5?-1:1)*(1.2+Math.random()*1.8);pose2=(Math.random()*2-1)*Math.PI;seed();notify('Random initial conditions generated');};
$('clear').onclick=()=>{clearTrails();notify('Trails cleared');};
$('spread').addEventListener('input',setSpreadFromInput);
$('speed').addEventListener('input',()=>{syncControls();});
$('speed2').addEventListener('input',()=>{$('speed').value=$('speed2').value;syncControls();});
$('armsToggle').onclick=()=>{arms=!arms;setSwitch('armsToggle',arms);};
$('trailsToggle').onclick=()=>{trails=!trails;setSwitch('trailsToggle',trails);if(!trails)clearTrails();};
$('pairToggle').onclick=()=>{pairOn=!pairOn;setSwitch('pairToggle',pairOn);};
document.querySelectorAll('[data-preset]').forEach(btn=>btn.onclick=()=>{
 const p=btn.dataset.preset;
 if(p==='calm'){pose1=.35;pose2=.45;spread=1e-7;}
 if(p==='chaotic'){pose1=2.6;pose2=-2.1;spread=1e-5;}
 if(p==='tiny'){pose1=2.15;pose2=2.35;spread=1e-10;}
 if(p==='wide'){pose1=2.15;pose2=2.35;spread=1e-2;}
 seed();notify('Preset loaded: '+btn.textContent.slice(5));
});
addEventListener('keydown',e=>{if(e.code==='Space'&&e.target.tagName!=='INPUT'){e.preventDefault();running=!running;updateHUD();}if(e.key.toLowerCase()==='r')seed();});
addEventListener('resize',resize);
function loop(now){
 requestAnimationFrame(loop);const dt=Math.min((now-last)/1000,.05);last=now;
 if(running&&!drag){acc+=dt*speed();let n=0;while(acc>=DT&&n<240){advance();acc-=DT;n++;}if(n===240)acc=0;if(++frame%3===0)sample();}
 draw();if(!running&&frame%20===0)updateHUD();
}
resize();spread=eps();seed();syncControls();requestAnimationFrame(loop);
})();
</script>
</body>
</html>
